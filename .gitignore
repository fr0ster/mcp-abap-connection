# Both spellings on purpose. `node_modules/` matches a directory and NOT a
# symlink to one, so a worktree that borrows the main checkout's install can
# hand `git add -A` an absolute symlink into somebody's home directory. It
# happened in mcp-abap-adt-interfaces; this is the same trap, closed before it
# does.
node_modules
node_modules/
dist/
*.tsbuildinfo
# Credentials. Broad on purpose: an env file that picks up a suffix —
# `e19.env.stale`, `prod.env.bak` — stopped being caught by `*.env` and went
# from ignored to staged without anything looking different.
.env
.env.*
*.env
*.env.*
!*.env.example
!*.env.template

# Key material, whatever it is called.
*.key
*.pem
*.pfx
*.p12
*.jks
.DS_Store
*.log

mcp-abap-adt-connection*.tgz

# Git worktrees
.worktrees/
