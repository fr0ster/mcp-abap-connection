{
  "name": "@mcp-abap-adt/connection",
  "version": "14.0.0",
  "description": "ABAP connection layer for MCP ABAP ADT server",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "COPYING"
  ],
  "keywords": [
    "abap",
    "sap",
    "adt",
    "connection",
    "mcp",
    "abap-adt"
  ],
  "author": "Oleksii Kyslytsia <oleksij.kyslytsja@gmail.com>",
  "license": "LGPL-3.0-only",
  "homepage": "https://github.com/fr0ster/mcp-abap-connection#readme",
  "bugs": {
    "url": "https://github.com/fr0ster/mcp-abap-connection/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fr0ster/mcp-abap-connection.git"
  },
  "scripts": {
    "chrono": "node scripts/version-stats.mjs",
    "clean": "node scripts/clean.mjs",
    "lint": "npx biome check --write src scripts",
    "lint:check": "npx biome check src scripts --error-on-warnings && node tools/check-provider-shape.mjs --rules 4,5,6",
    "format": "npx biome format --write src scripts",
    "build": "npm run --silent clean && npx biome check src scripts --diagnostic-level=error && npx tsc -p tsconfig.json && npm run --silent typecheck:scripts",
    "build:fast": "npx tsc -p tsconfig.json",
    "test": "npm run --silent check:docs && jest",
    "prepublishOnly": "npm run build && npm run lint:check && npm run check:docs && npm run --silent check:pack",
    "check:docs": "node scripts/check-docs.mjs",
    "typecheck:scripts": "npx tsc -p tsconfig.scripts.json",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "engines": {
    "node": "^22 || ^24 || ^26"
  },
  "dependencies": {
    "@mcp-abap-adt/auth-errors": "^2.1.1",
    "@mcp-abap-adt/interfaces-adt-connection": "^1.0.0",
    "@mcp-abap-adt/interfaces-auth": "^7.5.0",
    "@mcp-abap-adt/interfaces-auth-sap": "^3.3.0",
    "@mcp-abap-adt/interfaces-network": "^2.0.0",
    "@mcp-abap-adt/interfaces-utils": "^1.1.0",
    "axios": "^1.16.0"
  },
  "optionalDependencies": {
    "@mcp-abap-adt/sap-rfc-lite": "^0.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@mcp-abap-adt/auth-providers": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.3",
    "dotenv": "^17.3.1",
    "jest": "^30.2.0",
    "jest-util": "^30.2.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
